PORT=3000
HARU_DB_PATH=./data/haru.sqlite
HARU_LATITUDE=35.2279
HARU_LONGITUDE=128.6811
HARU_TIMEZONE=Asia/Seoul
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CODEX_ENABLED=false
# 취향 규칙 생성 제공자: api(OpenAI 직접 호출, OPENAI_API_KEY 필요) | codex(Codex CLI, CODEX_ENABLED=true 와 같음) | fallback(AI 없음)
# 비우면 OPENAI_API_KEY 가 있을 때 api, 없으면 fallback
RULES_PROVIDER=
# 규칙 생성 모델. 비우면 OPENAI_CHAT_MODEL 을 쓴다
OPENAI_RULES_MODEL=
CODEX_TIMEOUT_MS=90000
CODEX_CONCURRENCY=2

# 챗봇(OpenAI). 키는 서버 런타임 환경변수로만 둔다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
CHAT_RATE_LIMIT_PER_MINUTE=20

# 장소 검색(Kakao Local). REST 키는 서버에만 둔다. 비우면 지도 없이 추천만 동작한다.
KAKAO_REST_KEY=
# fixed: 아래 고정 좌표에서만 검색(데모 기본) / user: 프론트가 보낸 좌표 사용, 없으면 고정 좌표
PLACES_LOCATION_MODE=fixed
PLACES_CENTER_LAT=35.2222
PLACES_CENTER_LNG=128.6834
PLACES_CENTER_LABEL=상남시장
# 요청에 radiusKm 가 없고 온보딩 반경도 없을 때의 기본 반경(km)
PLACES_RADIUS_KM=2
